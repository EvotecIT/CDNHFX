powerforge-cdnhfx ALL=(root) NOPASSWD: /usr/local/sbin/powerforge-site-deploy ^--site cdnhfx\.evotec\.xyz --archive /tmp/powerforge-[0-9]+-[0-9]+-cdnhfx\.evotec\.xyz/artifact\.tar --metadata /tmp/powerforge-[0-9]+-[0-9]+-cdnhfx\.evotec\.xyz/deployment\.json --defer-public-verification$
